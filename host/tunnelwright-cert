#!/usr/bin/env bash
# Tunnelwright Panel AWG — самоподписанный TLS-сертификат панели.
# Выпускает сертификат, если его нет или до истечения меньше RENEW_DAYS дней,
# и перезагружает nginx в контейнере web. Запускается установщиком и systemd-таймером раз в сутки.
set -euo pipefail

BASE_DIR="/opt/tunnelwright"
TLS_DIR="${BASE_DIR}/tls"
VALID_DAYS=365
RENEW_DAYS=30

WG_HOST=""
# shellcheck disable=SC1091
[[ -f "${BASE_DIR}/panel.env" ]] && source "${BASE_DIR}/panel.env"
[[ -n "$WG_HOST" ]] || { echo "tunnelwright-cert: WG_HOST не задан в ${BASE_DIR}/panel.env" >&2; exit 1; }

cert="${TLS_DIR}/cert.pem"
key="${TLS_DIR}/key.pem"

if [[ -f "$cert" && "${1:-}" != "--force" ]] \
   && openssl x509 -checkend $((RENEW_DAYS * 86400)) -noout -in "$cert" >/dev/null 2>&1 \
   && openssl x509 -noout -ext subjectAltName -in "$cert" 2>/dev/null | grep -qF "$WG_HOST"; then
  exit 0   # действителен ещё больше RENEW_DAYS дней и выпущен на текущий адрес
fi

if [[ "$WG_HOST" =~ ^[0-9.]+$ || "$WG_HOST" == *:* ]]; then
  san="IP:${WG_HOST}"
else
  san="DNS:${WG_HOST}"
fi

mkdir -p "$TLS_DIR"
umask 077
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
  -days "$VALID_DAYS" -subj "/CN=${WG_HOST}/O=Tunnelwright Panel AWG" \
  -addext "subjectAltName=${san}" -addext "keyUsage=digitalSignature" -addext "extendedKeyUsage=serverAuth" \
  -keyout "${key}.new" -out "${cert}.new" 2>/dev/null
chmod 644 "${cert}.new"   # nginx в контейнере читает сертификат под своим пользователем
chmod 640 "${key}.new"
mv "${key}.new" "$key"
mv "${cert}.new" "$cert"
echo "tunnelwright-cert: выпущен сертификат для ${WG_HOST} до $(openssl x509 -enddate -noout -in "$cert" | cut -d= -f2)"

if docker inspect tunnelwright-web >/dev/null 2>&1; then
  docker exec tunnelwright-web nginx -s reload >/dev/null 2>&1 || docker restart tunnelwright-web >/dev/null
fi
