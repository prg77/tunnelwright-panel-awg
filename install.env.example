# Параметры non-interactive установки. Скопируйте в install.env рядом с install.sh.
# Файл содержит секреты — не коммитьте его (install.env в .gitignore).

GITHUB_TOKEN=            # необязательно: токен GitHub, если упираетесь в лимит анонимных запросов к API

INSTALL_WG_HOST=         # публичный IP или домен сервера
INSTALL_PASSWORD=        # пароль Web UI, минимум 8 символов
INSTALL_WEB_PORT=58821
INSTALL_WG_PORT=58820
INSTALL_LANG=ru

INSTALL_TG_TOKEN=        # необязательно: Telegram-бот
INSTALL_TG_CHAT_ID=
